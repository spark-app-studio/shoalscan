<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Every 15 minutes, scan the new heads of the open pull requests of every
  repository registered in the dashboard's scan_targets.toml with
  pull_requests = true (see docs/scheduled-scans.md). It lists them with an
  anonymous git ls-remote, needs no credentials, posts nothing anywhere, and
  uses the same worker, lock and audit as the dashboard's Run a fresh scan.

  1. Replace /Users/you and the path to shoalscan below.
  2. Copy this file to ~/Library/LaunchAgents/local.shoalscan.pull-requests.plist
  3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.shoalscan.pull-requests.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.shoalscan.pull-requests</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/you/.cache/shoalscan/venv/bin/shoalscan</string>
    <string>scanjob</string>
    <string>--pull-requests</string>
    <string>--state-dir</string>
    <string>/Users/you/.config/shoalscan/dashboard</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/you/Library/Logs/shoalscan-pull-requests.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/Library/Logs/shoalscan-pull-requests.log</string>
</dict>
</plist>

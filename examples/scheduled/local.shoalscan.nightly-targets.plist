<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One nightly job for every repository registered in the dashboard's
  scan_targets.toml with nightly = true (see docs/scheduled-scans.md and
  docs/dashboard-scanning.md). It scans them one after another with the same worker, lock
  and audit as the dashboard's Run a fresh scan.

  1. Replace /Users/you and the path to shoalscan below.
  2. Copy this file to ~/Library/LaunchAgents/local.shoalscan.nightly-targets.plist
  3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.shoalscan.nightly-targets.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.shoalscan.nightly-targets</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/you/.cache/shoalscan/venv/bin/shoalscan</string>
    <string>scanjob</string>
    <string>--nightly</string>
    <string>--state-dir</string>
    <string>/Users/you/.config/shoalscan/dashboard</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/you/Library/Logs/shoalscan-nightly-targets.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/Library/Logs/shoalscan-nightly-targets.log</string>
</dict>
</plist>
